---
import type { MarkdownHeading } from 'astro';
import Breadcrumbs from '../components/shell/Breadcrumbs.astro';
import Header from '../components/shell/Header.astro';
import Sidebar from '../components/shell/Sidebar.astro';
import SiteFooter from '../components/shell/SiteFooter.astro';
import SiteHead from '../components/shell/SiteHead.astro';
import Toc from '../components/shell/Toc.astro';
import '../styles/tokens.css';
import '../styles/fonts.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  headings?: MarkdownHeading[];
  crumbs?: { label: string; href?: string }[];
  noindex?: boolean;
}

const { title, description, headings = [], crumbs = [], noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SiteHead
      title={`${title} | Inferogenesis`}
      description={description}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <Header />
    <div class="frame">
      <Sidebar />
      <main id="main">
        {crumbs.length > 0 && <Breadcrumbs crumbs={crumbs} />}
        <slot />
      </main>
      <Toc headings={headings} />
    </div>
    <SiteFooter />
  </body>
</html>
