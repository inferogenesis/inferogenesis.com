---
type Kind = 'note' | 'warning' | 'roadmap';

interface Props {
  kind: Kind;
  title?: string;
}

const labels: Record<Kind, string> = {
  note: 'Note',
  warning: 'Warning',
  roadmap: 'Roadmap',
};
const { kind, title = labels[kind] } = Astro.props;
---

<aside class:list={['callout', kind]} aria-label={title}>
  <span class="ring" aria-hidden="true"></span>
  <p class="title">{title}</p>
  <div class="body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0 0.5rem;
    margin: 1.5rem 0;
    padding: 1rem;
    border: 1px solid var(--text-muted);
    border-radius: 6px;
    background: var(--surface);
  }
  .ring {
    grid-row: 1 / span 2;
    width: 1rem;
    height: 1rem;
    margin-top: 0.15rem;
    border: 3px solid var(--callout-ring);
    border-radius: 50%;
  }
  .note {
    --callout-ring: var(--link);
  }
  .warning {
    --callout-ring: var(--fail);
  }
  .roadmap {
    --callout-ring: var(--text-muted);
  }
  .roadmap .ring {
    border-style: dashed;
  }
  .title {
    margin: 0;
    font-weight: 700;
  }
  .body {
    grid-column: 2;
  }
  .body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
