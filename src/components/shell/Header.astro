---
import Mark from './Mark.astro';
import MenuToggle from './MenuToggle.astro';
import PrimaryNavList from './PrimaryNavList.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  hasSidebar?: boolean;
}

const { hasSidebar = true } = Astro.props;
// The nav and the theme toggle appear twice, in the wide row and in the phone menu, so
// focus order follows what shows at each width. CSS shows one of each.
---

<header class="site-header">
  <a class="home" href="/">
    <Mark />
    <span class="wordmark">Inferogenesis</span>
  </a>
  <nav class="wide-only" aria-label="Primary">
    <PrimaryNavList direction="row" />
  </nav>
  <div class="tools">
    <span class="wide-only">
      <ThemeToggle />
    </span>
    <Search />
    <MenuToggle controls={hasSidebar ? ['site-menu', 'site-sidebar'] : ['site-menu']} />
  </div>
  <div class="site-menu" id="site-menu">
    <nav aria-label="Primary">
      <PrimaryNavList direction="column" />
    </nav>
    <div class="menu-theme">
      <span>Theme</span>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--text-muted);
    background: var(--bg-gradient, var(--bg));
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }
  .wordmark {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  .wide-only {
    display: inline-flex;
  }
  .site-menu {
    display: none;
  }
  @media (max-width: 767px) {
    .site-header {
      gap: 0.5rem 1rem;
    }
    .wide-only {
      display: none;
    }
    .tools {
      gap: 0.5rem;
    }
    .site-menu[data-open] {
      display: block;
      flex-basis: 100%;
    }
    .menu-theme {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 0.25rem;
      padding-top: 0.5rem;
      border-top: 1px solid var(--text-muted);
    }
  }
</style>
