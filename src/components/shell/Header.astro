---
import Mark from './Mark.astro';
import MenuToggle from './MenuToggle.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const top = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Programmes', href: '/programmes/' },
  { label: 'Research', href: '/research/' },
  { label: 'Writing', href: '/writing/' },
  { label: 'Learn', href: '/learn/' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
  <a class="home" href="/">
    <Mark />
    <span class="wordmark">Inferogenesis</span>
  </a>
  <nav aria-label="Primary">
    <ul>
      {top.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'true' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <div class="tools">
    <Search />
    <ThemeToggle />
    <MenuToggle />
  </div>
</header>

<style>
  .site-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--text-muted);
    background: var(--bg-gradient, var(--bg));
  }
  .home {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
  }
  .wordmark {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.125rem;
  }
  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  nav a {
    color: var(--text);
    text-decoration: none;
  }
  nav a[aria-current='true'] {
    color: var(--accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  @media (max-width: 767px) {
    nav {
      display: none;
    }
  }
</style>
