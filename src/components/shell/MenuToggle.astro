---
interface Props {
  controls: string[];
}

const { controls } = Astro.props;
---

<button
  type="button"
  class="menu-toggle"
  aria-expanded="false"
  aria-controls={controls.join(' ')}
  data-menu-toggle
>
  Menu
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const targets = (button?.getAttribute('aria-controls') ?? '')
    .split(' ')
    .map((id) => document.getElementById(id));
  const isOpen = () => button?.getAttribute('aria-expanded') === 'true';

  function setOpen(open: boolean) {
    button?.setAttribute('aria-expanded', String(open));
    for (const target of targets) target?.toggleAttribute('data-open', open);
  }

  button?.addEventListener('click', () => setOpen(!isOpen()));
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !isOpen()) return;
    setOpen(false);
    button?.focus();
  });
</script>

<style>
  .menu-toggle {
    display: none;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--text-muted);
    border-radius: 999px;
    background: transparent;
    color: var(--text);
    cursor: pointer;
  }
  @media (max-width: 767px) {
    .menu-toggle {
      display: inline-block;
    }
  }
</style>
