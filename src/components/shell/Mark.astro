---
interface Props {
  size?: number;
}

const { size = 28 } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 100 100" aria-hidden="true" class="mark">
  <circle
    cx="50"
    cy="26"
    r="15"
    fill="none"
    stroke="var(--accent-mark)"
    stroke-width="6.5"
  ></circle>
  <circle cx="50" cy="26" r="4.5" fill="currentColor"></circle>
  <rect x="43.5" y="44" width="13" height="44" rx="6.5" fill="currentColor"></rect>
</svg>

<style>
  .mark {
    display: block;
    color: var(--text);
  }
</style>
