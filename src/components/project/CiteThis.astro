---
import { bibtex, type Citable } from '../../lib/cite';

interface Props {
  project: Citable & { citationFile?: string };
}

const { project } = Astro.props;
---

<pre
  class="bibtex"
  tabindex="0"
  aria-label="BibTeX record"
><code>{bibtex(project)}</code></pre>
{project.citationFile && (
  <p>
    The same record in Citation File Format:{' '}
    <a href={project.citationFile}>CITATION.cff at v{project.version}</a>.
  </p>
)}
