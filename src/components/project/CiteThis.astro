---
import { bibtex, type Citable } from '../../lib/cite';

interface Props {
  project: Citable & { citationFile?: string; releaseTag?: string };
}

const { project } = Astro.props;
---

<pre class="bibtex"><code>{bibtex(project)}</code></pre>
{project.citationFile && (
  <p>
    The same record in Citation File Format:{' '}
    <a href={project.citationFile}>CITATION.cff at {project.releaseTag}</a>.
  </p>
)}

<style>
  .bibtex {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
