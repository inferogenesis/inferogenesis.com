---
import type { Release } from '../../lib/releases';

interface Props {
  releases: Release[];
}

const { releases } = Astro.props;
---

<ul class="releases">
  {releases.map((release) => (
    <li>
      <a href={release.url}>{release.releaseTag ?? release.version}</a>
      <time datetime={release.published}>{release.published}</time>
    </li>
  ))}
</ul>

<style>
  ul {
    padding: 0;
    list-style: none;
  }
  li {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--text-muted);
  }
  time {
    color: var(--text-muted);
  }
</style>
