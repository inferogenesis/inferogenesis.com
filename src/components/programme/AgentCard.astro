---
import '../../styles/diagram.css';

interface Props {
  // The same agent drawn a second time, as when a cell reads the world it acted on.
  sameAgent?: boolean;
}

const { sameAgent = false } = Astro.props;
---

<svg viewBox="0 0 96 64" aria-hidden="true" class="diagram agent-card">
  <rect
    x="1"
    y="1"
    width="94"
    height="62"
    rx="6"
    class={sameAgent ? 'd-cell-same' : 'd-cell'}
  ></rect>
  <rect x="20" y="18" width="8" height="8" class="d-node"></rect>
  <rect x="44" y="18" width="8" height="8" class="d-node"></rect>
  <rect x="68" y="18" width="8" height="8" class="d-node"></rect>
  <path d="M6 22H20M28 22H44M52 22H68M76 22H90" class="d-edge"></path>
  <text x="48" y="49" text-anchor="middle" class="d-muted card-label">
    own EFE
  </text>
</svg>

<style>
  .agent-card {
    width: 4.5rem;
  }
  .card-label {
    font-size: 13px;
  }
</style>
