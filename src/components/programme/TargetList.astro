---
import type { LiteratureItem, Target } from '../../content/schemas';
import Callout from '../Callout.astro';
import RichText from './RichText.astro';

interface Props {
  targets: Target[];
  literature: LiteratureItem[];
  definitions: Map<string, string>;
}

const { targets, literature, definitions } = Astro.props;
---

<Callout kind="roadmap" title="Registered. None has run.">
  <p>Each line is a target or a registered prediction. A tag on the page links here.</p>
  <dl class="lines">
    {targets.map((target) => (
      <div id={`target-${target.id}`}>
        <dt>{target.id}</dt>
        <dd class="term-host">
          <RichText
            text={target.claim}
            definitions={definitions}
            id={`target-${target.id}`}
          />
        </dd>
      </div>
    ))}
  </dl>
  <p>
    Literature checks. A rung's biology wording stays provisional until its L item
    closes against the paper.
  </p>
  <dl class="lines">
    {literature.map((item) => (
      <div id={`literature-${item.id}`}>
        <dt>{item.id}</dt>
        <dd>
          {item.status === 'open' ? 'open. ' : 'closed. '}
          {item.source
            ? item.status === 'open'
              ? `${item.source}, as recorded and not yet checked against the paper.`
              : item.source
            : 'Source not chosen yet.'}
        </dd>
      </div>
    ))}
  </dl>
</Callout>

<style>
  .lines {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .lines div {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    gap: 0.75rem;
    scroll-margin-top: 1rem;
  }
  .lines div:target {
    outline: 1px solid var(--link);
    outline-offset: 4px;
    border-radius: 2px;
  }
  dt {
    font-family: var(--font-code);
    font-size: 0.85rem;
    font-weight: 500;
  }
  dd {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
