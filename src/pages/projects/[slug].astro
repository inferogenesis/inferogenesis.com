---
import { getCollection, render } from 'astro:content';
import ProjectBody from '../../components/project/ProjectBody.astro';
import Base from '../../layouts/Base.astro';
import { appliedPath, appliedWriteUps } from '../../lib/applied';
import { lastModified } from '../../lib/lastModified';
import { resolvePythonRange } from '../../lib/pypi';
import { citationFileUrl, latestReleases, projectReleases } from '../../lib/releases';
import { softwareSourceCode } from '../../lib/structuredData';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const snapshot = await projectReleases(entry.id);
const releases = latestReleases(snapshot);
const citationFile = entry.data.hasCitationFile ? citationFileUrl(snapshot) : undefined;
const pythonRange = entry.data.pypi
  ? (await resolvePythonRange(entry.id, entry.data.pypi, releases[0].version))
      .requiresPython
  : null;

const software = softwareSourceCode(
  entry.data,
  releases[0],
  pythonRange,
  new URL(Astro.url.pathname, Astro.site).href,
);

const applied = (await appliedWriteUps(entry.id)).map((writeUp) => ({
  title: writeUp.data.title,
  description: writeUp.data.description,
  href: appliedPath(writeUp),
}));

const sourcePath = `src/content/projects/${entry.id}.mdx`;
const fixedHeadings = [
  { depth: 2, slug: 'install', text: 'Install' },
  { depth: 2, slug: 'example', text: 'Example' },
  ...headings,
  ...(applied.length > 0 ? [{ depth: 2, slug: 'applied', text: 'Applied' }] : []),
  { depth: 2, slug: 'capabilities', text: 'Capabilities' },
  { depth: 2, slug: 'releases', text: 'Releases' },
  { depth: 2, slug: 'cite', text: 'Cite this' },
];
---

<Base
  title={entry.data.name}
  description={entry.data.description}
  headings={fixedHeadings}
  crumbs={[{ label: 'Projects', href: '/projects/' }, { label: entry.data.name }]}
  structuredData={software}
>
  <ProjectBody
    entry={entry}
    releases={releases}
    citationFile={citationFile}
    pythonRange={pythonRange}
    applied={applied}
    lastModified={lastModified(sourcePath)}
    editUrl={`https://github.com/inferogenesis/inferogenesis.com/edit/main/${sourcePath}`}
    issueUrl="https://github.com/inferogenesis/inferogenesis.com/issues/new/choose"
  >
    <Content />
  </ProjectBody>
</Base>
