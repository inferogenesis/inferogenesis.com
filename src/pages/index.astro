---
import '../styles/tokens.css';

const title = 'Inferogenesis';
const tagline = 'continuous active inference, from the first cell';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={tagline} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://inferogenesis.com/" />
    <title>{title}</title>
  </head>
  <body>
    <main>
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      <p>
        Home of <a href="https://cpomdp.inferogenesis.com/">cpomdp</a>, continuous
        active inference for Python. The full site is under construction.
      </p>
      <ul>
        <li>
          <a href="https://github.com/inferogenesis">GitHub</a>
        </li>
        <li>
          <a href="https://pypi.org/project/cpomdp/">cpomdp on PyPI</a>
        </li>
      </ul>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: system-ui, sans-serif;
    line-height: 1.5;
  }
  main {
    max-width: 75ch;
    margin: 0 auto;
    padding: 4rem 1rem;
  }
  .tagline {
    color: var(--text-muted);
    font-style: italic;
  }
  a {
    color: var(--link);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>
