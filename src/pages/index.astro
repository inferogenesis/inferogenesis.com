---
import ProjectGrid from '../components/project/ProjectGrid.astro';
import Landing from '../layouts/Landing.astro';

const tagline = 'continuous active inference, from the first cell';
---

<Landing description={`Inferogenesis: ${tagline}.`}>
  <h1>Inferogenesis</h1>
  <p class="tagline">{tagline}</p>
  <p class="intro">
    Inferogenesis builds open-source software for continuous active inference, and the
    research that tests it. Each project page starts with the install command and a
    short example.
  </p>

  <h2>Projects</h2>
  <ProjectGrid />
</Landing>

<style>
  h1 {
    margin: 0;
    font-size: 2.5rem;
  }
  .tagline {
    margin: 0.25rem 0 1.5rem;
    color: var(--text-muted);
    font-size: 1.125rem;
    font-style: italic;
  }
  .intro {
    max-width: 65ch;
    margin-bottom: 2.5rem;
  }
</style>
